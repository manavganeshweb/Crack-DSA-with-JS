
// 142-problem Linked List Cycle II
var detectCycle = function (head) {
    let slow = head, fast = head

    while (fast && fast.next) {
        slow = slow.next
        fast = fast.next.next

        if (slow === fast) {
            let slow = head
            while (slow !== fast) {
                slow = slow.next
                fast = fast.next
            }
            return slow
        }
    }
    return null
};
// Time Complexity: O(n)
// Space Complexity: O(1)
