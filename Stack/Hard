
// 224-problem Basic Calculator
var calculate = function (s) {
    let stack = []
    let num = 0, result = 0, sign = 1

    for (let i = 0; i < s.length; i++) {
        let ch = s[i]

        if (ch >= '0' && ch <= '9') {
            num = num * 10 + Number(ch)
        }else if (ch === '+') {
            result += sign * num
            num = 0
            sign = 1
        } else if (ch === '-') {
            result += sign * num
            num = 0
            sign = -1
        } else if (ch === '(') {
            stack.push(result)
            stack.push(sign)
            result = 0
            sign = 1

        } else if (ch === ')') {
            result += sign * num
            num = 0
            result *= stack.pop()
            result += stack.pop()
        }
    }
    return result + sign * num
};
// Time Complexity: O(n)
// Space Complexity: O(n)
// using recursion : Recursion-Hard