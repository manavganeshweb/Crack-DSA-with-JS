

// 224-problem Basic Calculator
var calculate = function(s) {
    let i = 0;

    function solve() {
        let num = 0;
        let result = 0;
        let sign = 1;

        while (i < s.length) {
            let ch = s[i];

            // build number
            if (ch >= '0' && ch <= '9') {
                num = num * 10 + (ch - '0');
            }

            // plus
            else if (ch === '+') {
                result += sign * num;
                num = 0;
                sign = 1;
            }

            // minus
            else if (ch === '-') {
                result += sign * num;
                num = 0;
                sign = -1;
            }

            // recursion for (
            else if (ch === '(') {
                i++;
                num = solve();
            }

            // end recursion at )
            else if (ch === ')') {
                result += sign * num;
                return result;
            }

            i++;
        }

        return result + sign * num;
    }

    return solve();
};
// Time Complexity: O(n)
// Space Complexity: O(n)
// using Stack : Stack-Hard