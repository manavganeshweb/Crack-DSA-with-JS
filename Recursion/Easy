
// 104-problem Maximum Depth of Binary Tree
var maxDepth = function(root) {
    if(root === null) return 0

    let left = maxDepth(root.left)
    let right = maxDepth(root.right)

    return 1 + Math.max(left, right)
};
// Time Complexity: O( n)
// Space Complexity: O(h) hight of tree

// 509-problem Fibonacci Number
var fib = function (n) {
    if (n <= 1) return n

    let a = 0, b = 1

    for (let i = 2; i <= n; i++) {
        let c = a + b
        a = b
        b = c
    }
    return b
};
// Time Complexity: O( n)
// Space Complexity: O(1)