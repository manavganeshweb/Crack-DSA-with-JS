
// 172-problem Factorial Trailing Zeroes
var trailingZeroes = function (n) {
    let count = 0
    while (n >= 5) {
        n = Math.floor(n / 5)
        count += n
    }
    return count
};
// Time Complexity: O(log n)
// Space Complexity: O(1)

// 606-problem Construct String from Binary Tree
var tree2str = function (root) {
    if (root === null) return ""

    if (!root.left && !root.right) return String(root.val)

    if (!root.right) {
        return `${root.val}(${tree2str(root.left)})`
    }
    return `${root.val}(${tree2str(root.left)})(${tree2str(root.right)})`
};
// Time Complexity: O(n)
// Space Complexity: O(h)

// 779-problem K-th Symbol in Grammar
var kthGrammar = function (n, k) {
    if (n === 1) return 0

    let length = Math.pow(2, n - 1)
    let mid = length / 2

    if (k <= mid) {
        return kthGrammar(n - 1, k)
    } else {
        return kthGrammar(n - 1, k - mid) ^ 1
    }
};
// Time Complexity: O(log n)
// Space Complexity: O(1)