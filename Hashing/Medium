
// 128-problem Longest Consecutive Sequence
var longestConsecutive = function(nums) {
    let set = new Set(nums)
    let longest = 0

    for(let num of set){
        if(!set.has(num - 1)){
            let current = num
            let count = 1

            while(set.has(current + 1)){
                current++
                count++
            }
            longest = Math.max(longest,count)
        }
    }
    return longest 
};
// Time Complexity: O(n)
// Space Complexity: O(n)