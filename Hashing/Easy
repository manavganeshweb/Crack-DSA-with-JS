// 001-problem Two sum
var twoSum = function(nums, target) {
    let map = new Map()
    for(let i = 0; i < nums.length; i++){
        let comp = target - nums[i]
        if(map.has(comp)) return [ map.get(comp), i]
        map.set(nums[i], i)
    }
};
// Time Complexity: O(n)
// space Complexity: O(n)

//202-problem happy number 
var getNext = function (num) {
    let sum = 0
    while (num > 0) {
        let digit = num % 10
        sum += digit * digit
        num = Math.floor(num / 10)
    }
    return sum
}
var isHappy = function (n) {

    let slow = n, fast = n;

    while (true) {
        slow = getNext(slow)
        fast = getNext(getNext(fast))

        if (fast == 1) return true
        if (slow == fast) return false
    }

};
// Time Complexity: O(n)
// space Complexity: O(n)

// 217-problem contain duplicate
function containDup(num) {
    let set = new Set()

    for(let n of num){
        if(set.has(n)) return true
        set.add(n)
    }
    return false
}
// Time Complexity: O(n)
// Space Complexity: O(n)

// 219-problem contain duplicate 2
function containDup(nums, k){
    let set = new Set()

    for(let i = 0; i < nums.length;i++){
        if(set.size > k) set.delete(nums[i - k])

        if(set.has(nums[i])) return true

        set.add(nums[i])
    }
    return false
}
// Time Complexity: O(n)
// Space Complexity: O(k)

// 242-problem valid anagram
var isAnagram = function (s, t) {
    let arr = new Array(26).fill(0)
    if (s.length !== t.length) return false;
    for (let i = 0; i < s.length; i++) {
        arr[s.charCodeAt(i) - 97]++
    }
    for (let i = 0; i < t.length; i++) {
        let ind = t.charCodeAt(i) - 97
        arr[ind]--
        if (arr[ind] < 0) return false
    }
    return true
};
// Time Complexity: O(n)
// Space Complexity: O(1)
