// 78-problem Subsets
var subsets = function (nums) {

    let result = [];

    function backtrack(index, current) {

        if (index === nums.length) {
            result.push([...current]);
            return;
        }
        current.push(nums[index]);
        backtrack(index + 1, current);
        current.pop();
        backtrack(index + 1, current);
    }

    backtrack(0, []);

    return result;
};
// Time Complexity: O(n * 2^n)
// Space Complexity: O(n)

// 79-problem Word Search
var exist = function (board, word) {
    let row = board.length, col = board[0].length

    function solve(r, c, i) {
        if (i === word.length) return true

        if (r < 0 || c < 0 || r >= row || c >= col || board[r][c] !== word[i]) return false

        let temp = board[r][c]
        board[r][c] = '$'

        let found = solve(r + 1, c, i + 1) || solve(r - 1, c, i + 1) ||
            solve(r, c + 1, i + 1) || solve(r, c - 1, i + 1);

        board[r][c] = temp

        return found
    }

    for(let r = 0; r < row; r++){
        for(let c = 0; c <= col; c++){
            if(solve(r,c, 0)) return true
        }
    }
    return false
};
// Time Complexity: O(row * col * 4^L)
// Space Complexity: O(row * col)