
// 9-problem Palindrome Number
var isPalindrome = function(x) {
    let str = x.toString()
    let reversed = str.split('').reverse().join('')

    return str === reversed
};
// Time Complexity: O( n)
// Space Complexity: O(n)
// Using Math : DynamicProgramming-Easy

