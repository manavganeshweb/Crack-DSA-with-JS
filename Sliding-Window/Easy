// 27-problem Remove Element
var removeElement = function(nums, val) {
    let i = 0
    for(let j = 0; j< nums.length; j++){
        if(nums[j] !== val){
            nums[i] = nums[j]
            i++
        }
    }
    return i
};
// Time Complexity: O(n)
// Space Complexity: O(1)

// 594-problem Longest Harmonious Subsequence
var findLHS = function (nums) {
    nums.sort((a, b) => a - b);
    let left = 0;
    let maxLen = 0;
    for (let right = 0; right < nums.length; right++) {
        while (nums[right] - nums[left] > 1) {
            left++;
        }

        if (nums[right] - nums[left] === 1) {
            maxLen = Math.max(
                maxLen,
                right - left + 1
            );
        }
    }
    return maxLen;
};
// Time Complexity: O(n)
// Space Complexity: O(n)

// 643-problem Maximum Average Subarray I
var findMaxAverage = function (nums, k) {
  let sum = 0;

  for (let i = 0; i < k; i++) {
    sum += nums[i];
  }

  let maxSum = sum;

  for (let i = k; i < nums.length; i++) {
    sum = sum - nums[i - k] + nums[i];
    maxSum = Math.max(maxSum, sum);
  }

  return maxSum / k;
};
// Time Complexity: O(n)
// Space Complexity: O(1)

// 1652-problem Defuse the Bomb
var decrypt = function(code, k) {
    

    let n = code.length;

    let result = new Array(n).fill(0);

    if (k === 0) return result;

    let start, end;

    if (k > 0) {

        start = 1;

        end = k;

    } else {

        start = n + k;

        end = n - 1;

        k = -k;

    }

    let windowSum = 0;

    for (let i = start; i <= end; i++) {

        windowSum += code[i % n];

    }

    for (let i = 0; i < n; i++) {

        result[i] = windowSum;

        windowSum -= code[start % n];

        start++;

        end++;

        windowSum += code[end % n];

    }

    return result;
};
// Time Complexity: O(n)
// Space Complexity: O(n)