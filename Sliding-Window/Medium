// 904-problem Fruit Into Baskets
var totalFruit = function(fruits) {
  let map = new Map();

    let left = 0;

    let maxLen = 0;

    for (let right = 0; right < fruits.length; right++) {

        map.set(

            fruits[right],

            (map.get(fruits[right]) || 0) + 1

        );

        while (map.size > 2) {

            map.set(

                fruits[left],

                map.get(fruits[left]) - 1

            );

            if (map.get(fruits[left]) === 0) {

                map.delete(fruits[left]);

            }

            left++;

        }

        maxLen = Math.max(

            maxLen,

            right - left + 1

        );

    }

    return maxLen;

};

// 1004-problem Max Consecutive Ones III
var longestOnes = function(nums, k) {

    let i = 0;
    let zeroCount = 0;
    let maxLen = 0;

    for (let j = 0; j < nums.length; j++) {

        if (nums[j] === 0) {
            zeroCount++;
        }

        while (zeroCount > k) {

            if (nums[i] === 0) {
                zeroCount--;
            }

            i++;
        }

        maxLen = Math.max(
            maxLen,
            j - i + 1
        );
    }

    return maxLen;
};
// Time Complexity: O(k)
// Space Complexity: O(1)

// 1423-problem Maximum Points You Can Obtain from Cards
var maxScore = function (cardPoints, k) {
    let maxSum = 0
    for (let i = 0; i < k; i++) {
        maxSum += cardPoints[i]
    }
    let sum = maxSum
    let r = cardPoints.length - 1
    for (let i = k - 1; i >= 0; i--) {
        sum -= cardPoints[i]
        sum += cardPoints[r]
        r--
        maxSum = Math.max(sum, maxSum)
    }
    return maxSum
};
// Time Complexity: O(k)
// Space Complexity: O(1)

// 1456-problem Maximum Number of Vowels in a Substring of Given Length
var maxVowels = function (s, k) {
    let maxCount = 0
    let count = 0
    let i = 0, j = 0
    let vowels = new Set(['a', 'e', 'i', 'o', 'u'])
    while (j < s.length) {
        if (vowels.has(s[j])) {
            count++
        }
        if (j - i + 1 > k) {
            if (vowels.has(s[i])) {
                count--
            }
            i++
        }
        if (j - i + 1 === k) {
            maxCount = Math.max(count, maxCount)
        }
        j++
    }
    return maxCount
};
// Time Complexity: O(k)
// Space Complexity: O(5)