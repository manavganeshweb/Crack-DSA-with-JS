
// 1423-problem Maximum Points You Can Obtain from Cards
var maxScore = function (cardPoints, k) {
    let maxSum = 0
    for (let i = 0; i < k; i++) {
        maxSum += cardPoints[i]
    }
    let sum = maxSum
    let r = cardPoints.length - 1
    for (let i = k - 1; i >= 0; i--) {
        sum -= cardPoints[i]
        sum += cardPoints[r]
        r--
        maxSum = Math.max(sum, maxSum)
    }
    return maxSum
};
// Time Complexity: O(k)
// Space Complexity: O(1)

// 1456-problem Maximum Number of Vowels in a Substring of Given Length
var maxVowels = function (s, k) {
    let maxCount = 0
    let count = 0
    let i = 0, j = 0
    let vowels = new Set(['a', 'e', 'i', 'o', 'u'])
    while (j < s.length) {
        if (vowels.has(s[j])) {
            count++
        }
        if (j - i + 1 > k) {
            if (vowels.has(s[i])) {
                count--
            }
            i++
        }
        if (j - i + 1 === k) {
            maxCount = Math.max(count, maxCount)
        }
        j++
    }
    return maxCount
};
// Time Complexity: O(k)
// Space Complexity: O(5)