
// 53-problem Maximum Subarray
var maxSubArray = function (nums) {
    let sum = 0
    let max = -Infinity

    for (let num of nums) {
        sum += num
        max = Math.max(sum, max)
        if (sum < 0) {
            sum = 0
        }
    }
    return max
};
// Time Complexity: O(n)
// Space Complexity: O(1)

// 55-problem Jump Game
var canJump = function(nums) {
    let maxJump = 0
    for(let i = 0; i < nums.length; i++){
        if(i> maxJump) return false
        maxJump = Math.max(i + nums[i], maxJump)
    }
    return true 
};
// Time Complexity: O(n)
// Space Complexity: O(1)

// 57-problem Insert Interval
var insert = function (intervals, newInterval) {
    let result = []
    for (let interval of intervals) {
        if (interval[1] < newInterval[0]) {
            result.push(interval)
        } else if (interval[0] > newInterval[1]) {
            result.push(newInterval)
            newInterval = interval
        } else {
            newInterval[0] = Math.min(interval[0], newInterval[0])
            newInterval[1] = Math.max(interval[1], newInterval[1])
        }
    }
    result.push(newInterval)
    return result
};
// Time Complexity: O(n)
// Space Complexity: O(n)

// 45 problem Jump Game 2
var jump = function (nums) {
    let jump = 0
    let furthest = 0
    let r = 0
    for (let i = 0; i < nums.length - 1; i++) {

        furthest = Math.max(furthest, i + nums[i])
        if (i === r) {
            jump++
            r = furthest
        }
    }
    return jump
};
// Time Complexity: O(n)
// Space Complexity: O(1)

// 452-problem Minimum Number of Arrows to Burst Balloons
var findMinArrowShots = function (points) {
    if (points.length === 0) return 0;
    points.sort((a, b) => a[1] - b[1])
    let arrow = 1
    arrowPoi = points[0][1]

    for (let i = 0; i < points.length; i++) {
        if (points[i][0] > arrowPoi) {
            arrow++
            arrowPoi = points[i][1]
        }
    }
    return arrow
};
// Sort by ending position and always shoot the arrow at the earliest possible end.
// Time Complexity: O(n log n)
// Space Complexity: O(1)
