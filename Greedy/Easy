
// 455-problem Assign Cookies
var findContentChildren = function (g, s) {
    g.sort((a, b) => a - b)
    s.sort((a, b) => a - b)
    let i = 0, j = 0
    while (i <= g.length && j <= s.length) {
        if (g[i] <= s[j]) {
            i++
        }
        j++
    }
    return i
}
// Time Complexity: O(n log n + m log m)
// Space Complexity: O(1)
 