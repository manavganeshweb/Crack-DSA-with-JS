
// 455-problem Assign Cookies
var findContentChildren = function (g, s) {
    g.sort((a, b) => a - b)
    s.sort((a, b) => a - b)
    let i = 0, j = 0
    while (i <= g.length && j <= s.length) {
        if (g[i] <= s[j]) {
            i++
        }
        j++
    }
    return i
}
// Time Complexity: O(n log n + m log m)
// Space Complexity: O(1)
 
// 860-problem Lemonade Change
var lemonadeChange = function (bills) {
    let five = 0, ten = 0
    for (let bill of bills) {
        if (bill == 5) {
            five++
        } else if (bill === 10) {
            if (five > 0) {
                ten++
                five--
            } else {
                return false
            }
        } else {
            if (five > 0 && ten > 0) {
                five--
                ten--
            } else if (five >= 3) {
                five -= 3
            } else {
                return false
            }
        }
    }
    return true
};
// Time Complexity: O(n)
// Space Complexity: O(1)